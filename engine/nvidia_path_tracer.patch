@@ -145,11 +145,36 @@ public:
 static Vector<unsigned int> g_dlss_freeViewportIndices;
 static unsigned int g_dlss_viewportIndex = 1;
 
+// A context that reused a viewport handle would inherit the feature instances left on it, so a handle is freed before
+// it is reused, once the GPU is done with the frames that used it.
+struct DLSSRetiredViewport {
+	unsigned int viewport;
+	uint64_t frame;
+};
+static Vector<DLSSRetiredViewport> g_dlss_retiredViewports;
+
+static void dlss_free_retired_viewports() {
+	const uint64_t frame = RD::get_singleton()->get_frames_drawn();
+	for (int i = g_dlss_retiredViewports.size() - 1; i >= 0; i--) {
+		const DLSSRetiredViewport retired = g_dlss_retiredViewports[i];
+		if (frame <= retired.frame + RD::get_singleton()->get_frame_delay()) {
+			continue;
+		}
+		if (StreamlineContext::get().slFreeResources != nullptr) {
+			StreamlineContext::get().slFreeResources(sl::kFeatureDLSS, retired.viewport);
+			StreamlineContext::get().slFreeResources(sl::kFeatureDLSS_RR, retired.viewport);
+		}
+		g_dlss_freeViewportIndices.push_back(retired.viewport);
+		g_dlss_retiredViewports.remove_at(i);
+	}
+}
+
 DLSSContextInner::~DLSSContextInner() {
-	g_dlss_freeViewportIndices.push_back((unsigned int)viewport);
+	g_dlss_retiredViewports.push_back({ (unsigned int)viewport, RD::get_singleton()->get_frames_drawn() });
 }
 
 DLSSContextInner::DLSSContextInner() {
+	dlss_free_retired_viewports();
 	if (g_dlss_freeViewportIndices.size() == 0) {
 		g_dlss_freeViewportIndices.push_back(g_dlss_viewportIndex++);
 	}
