; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Radiance Cascades"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SceneCapture="*res://src/reference/scene_capture.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
pathtracing/async_shader_compilation=false
pathtracing/use_shader_execution_reordering=false
rendering_device/driver.windows="vulkan"
rendering_device/fallback_to_d3d12=false
rendering_device/fallback_to_opengl3=false
streamline/dlss_ray_reconstruction_preset="F"

[shader_globals]

gi_irradiance={
"type": "sampler2D",
"value": ""
}
gi_view={
"type": "int",
"value": 0
}
